{
  "name": "unisearch-tests",
  "private": true,
  "version": "6.10.0",
  "description": "Test runner configuration for UniSearch backend and frontend E2E suites.",
  "scripts": {
    "build:frontend-env": "node frontend/scripts/generate-env-js.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:frontend": "node scripts/dev-frontend.mjs",
    "audit:data": "node scripts/audit-data.mjs",
    "audit:images": "node scripts/audit-university-images.mjs && python scripts/audit-university-webp-visual.py",
    "audit:performance": "node scripts/performance-audit.mjs",
    "check:i18n": "node scripts/i18n-check.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:design-lint": "node scripts/check-design-lint.mjs --strict",
    "check:hardcoded-text": "node scripts/check-hardcoded-text.mjs",
    "check:inline-styles": "node scripts/check-inline-styles.mjs --strict",
    "fix:encoding": "node scripts/check-encoding.mjs --fix",
    "sync:heroicons": "node scripts/sync-heroicons.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:unit:coverage": "c8 --reporter=lcov --reporter=text --reports-dir=coverage/frontend node scripts/test-unit.mjs",
    "test:fast": "npm run test:unit && npm run test:backend",
    "test:smoke": "npm run test:unit && npx playwright test tests/e2e/smoke-home.spec.js --config=playwright.local.config.js",
    "test:e2e:pr": "npx playwright test --project=chromium --config=playwright.local.config.js",
    "test:e2e:nightly": "npx playwright test --project=chromium --project=firefox --project=webkit",
    "test:all": "npm run check:version && npm run check:encoding && npm run check:tokens && npm run check:design-lint && npm run check:hardcoded-text && npm run check:inline-styles && npm run test:backend && npm run test:unit && npm run test:e2e:pr",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.63.0",
    "c8": "12.0.0"
  }
}
