{
  "name": "unisearch-tests",
  "private": true,
  "version": "10.10.1",
  "description": "Test runner configuration for UniSearch backend and frontend E2E suites.",
  "scripts": {
    "build:frontend-env": "node frontend/scripts/generate-env-js.mjs",
    "build:snapshot": "node scripts/build-static-snapshot.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:frontend": "node scripts/dev-frontend.mjs",
    "audit:data": "node scripts/audit-data.mjs",
    "audit:dead-code": "knip",
    "audit:duplicates": "jscpd --config .jscpd.json",
    "audit:css": "node scripts/audit-css.mjs --strict",
    "audit:layout": "node scripts/audit-layout.mjs",
    "audit:images": "node scripts/audit-university-images.mjs && python scripts/audit-university-webp-visual.py",
    "audit:performance": "node scripts/performance-audit.mjs",
    "check:i18n": "node scripts/i18n-check.mjs && node scripts/i18n-pack-revision.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:design-lint": "node scripts/check-design-lint.mjs --strict",
    "check:stylelint": "stylelint \"frontend/css/**/*.css\"",
    "check:hardcoded-text": "node scripts/check-hardcoded-text.mjs",
    "check:inline-styles": "node scripts/check-inline-styles.mjs --strict",
    "check:ui-primitives": "node scripts/check-ui-primitives.mjs --strict",
    "fix:encoding": "node scripts/check-encoding.mjs --fix",
    "fix:i18n": "node scripts/i18n-pack-revision.mjs --fix",
    "lint:backend": "uvx --no-build --from ruff==0.17.6 ruff check --config backend/pyproject.toml backend/app",
    "lint:frontend": "oxlint --config .oxlintrc.json frontend/javascript frontend/config.js frontend/sw.js",
    "sync:heroicons": "node scripts/sync-heroicons.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:unit:coverage": "c8 --all --src=frontend/javascript --include=\"frontend/javascript/**/*.js\" --reporter=lcov --reporter=text --reports-dir=coverage/frontend --temp-directory=coverage/frontend/tmp node scripts/test-unit.mjs",
    "test:fast": "npm run test:unit && npm run test:backend",
    "test:smoke": "npm run test:unit && npx playwright test tests/e2e/smoke-home.spec.js --config=playwright.local.config.js",
    "test:e2e:pr": "npx playwright test --project=chromium --config=playwright.local.config.js",
    "test:e2e:nightly": "npx playwright test --project=chromium --project=firefox --project=webkit",
    "test:all": "npm run check:version && npm run check:encoding && npm run check:tokens && npm run check:design-lint && npm run check:stylelint && npm run audit:css && npm run check:hardcoded-text && npm run check:inline-styles && npm run check:ui-primitives && npm run check:i18n && npm run lint:frontend && npm run audit:dead-code && npm run audit:duplicates && npm run test:backend && npm run test:unit && npm run test:e2e:pr",
    "typecheck:backend": "node scripts/typecheck-backend.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.64.1",
    "@projectwallace/css-analyzer": "^9.9.9",
    "c8": "12.0.0",
    "jscpd": "^5.4.3",
    "knip": "^6.48.0",
    "oxc-parser": "0.156.0",
    "oxlint": "^1.95.0",
    "purgecss": "^9.1.0",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
