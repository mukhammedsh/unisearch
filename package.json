{
  "name": "unisearch-tests",
  "private": true,
  "version": "3.7.7",
  "description": "Test runner configuration for UniSearch backend and frontend E2E suites.",
  "scripts": {
    "build:frontend-env": "node frontend/scripts/generate-env-js.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:frontend": "node scripts/dev-frontend.mjs",
    "audit:performance": "node scripts/performance-audit.mjs",
    "check:i18n": "node scripts/i18n-check.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "fix:encoding": "node scripts/check-encoding.mjs --fix",
    "sync:heroicons": "node scripts/sync-heroicons.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e:pr": "npx playwright test --project=chromium --config=playwright.local.config.js",
    "test:e2e:nightly": "npx playwright test --project=chromium --project=firefox --project=webkit",
    "test:all": "npm run check:version && npm run check:encoding && npm run test:backend && npm run test:e2e:pr"
  },
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.52.0"
  }
}
