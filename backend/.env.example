# Backend basic settings
FRONTEND_ORIGINS=http://127.0.0.1:5501
# Optional multi-origin override (comma-separated), useful for local E2E:
# FRONTEND_ORIGINS=http://127.0.0.1:5501,http://127.0.0.1:5510
# Optional LAN access from another device in the same network:
# BACKEND_HOST=0.0.0.0
# FRONTEND_ORIGINS=http://127.0.0.1:5501,http://localhost:5501,http://<your-lan-ip>:5501
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5501

# Public hardening
# Set a long random token before exposing /ops/*, /metrics, or /health?warmup=1.
OPS_ADMIN_TOKEN=
OPS_ADMIN_HEADER=X-UniSearch-Ops-Token
DOCS_ENABLED=0
METRICS_ENABLED=0
REQUEST_BODY_MAX_BYTES=131072
RATE_LIMIT_ENABLED=1
GLOBAL_RATE_LIMIT_REQUESTS=600
GLOBAL_RATE_LIMIT_WINDOW_SEC=60
EXPENSIVE_RATE_LIMIT_REQUESTS=120
EXPENSIVE_RATE_LIMIT_WINDOW_SEC=60

# Trust X-Forwarded-For only behind an explicit reverse proxy allowlist.
TRUST_X_FORWARDED_FOR=0
TRUST_PRIVATE_NETWORK_PROXIES=1
TRUST_CF_CONNECTING_IP=1
TRUSTED_PROXY_IPS=

# ML interests translation (self-host LibreTranslate)
ML_INTEREST_TRANSLATION_ENABLED=1
ML_INTEREST_TRANSLATION_PROVIDER=libretranslate
ML_INTEREST_TRANSLATION_TARGET=en
ML_INTEREST_TRANSLATION_SOURCE=auto
LIBRETRANSLATE_URL=http://127.0.0.1:5000/translate
LIBRETRANSLATE_API_KEY=
ML_INTEREST_TRANSLATION_TIMEOUT_SEC=2.5
ML_INTEREST_TRANSLATION_CACHE_TTL_SEC=86400
ML_INTEREST_TRANSLATION_CACHE_MAX_ITEMS=2000
ML_INTEREST_TRANSLATION_RATE_LIMIT_REQUESTS=40
ML_INTEREST_TRANSLATION_RATE_LIMIT_WINDOW_SEC=60
ML_INTEREST_TRANSLATION_FAILURE_BACKOFF_SEC=20

# Currency rates
CURRENCY_RATES_ENABLED=1
CURRENCY_RATES_API_URL=https://open.er-api.com/v6/latest/USD
CURRENCY_RATES_CACHE_TTL_SEC=43200
CURRENCY_RATES_TIMEOUT_SEC=5.0
CURRENCY_RATES_BACKOFF_SEC=300

# Data refresh scripts
# Keep a small delay by default to avoid hammering public APIs; set to 0 only for controlled local refreshes.
UNISEARCH_FACTOR_REFRESH_REQUEST_DELAY_SEC=0.12

