# UniMentor / Gemini settings
# Copy to backend/.env and fill values (backend/.env is gitignored).

UNIMENTOR_NAME=UniMentor
UNIMENTOR_PROVIDER=gemini
UNIMENTOR_ENABLE_ONLINE=1
UNIMENTOR_TIMEOUT=10

# Gemini model + key
UNIMENTOR_GEMINI_MODEL=gemini-2.0-flash
UNIMENTOR_GEMINI_ENABLE_WEB=1
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

