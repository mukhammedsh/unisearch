{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "/javascript/*": ["frontend/javascript/*"]
    }
  },
  "exclude": [
    "node_modules",
    "backend",
    "coverage",
    "playwright-report",
    "test-results",
    ".venv"
  ]
}
