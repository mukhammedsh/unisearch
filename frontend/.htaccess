Options -MultiViews
RewriteEngine On

# Keep direct file and directory access intact.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Pretty URL routes for static frontend pages.
RewriteRule ^$ index.html [L]
RewriteRule ^universities/?$ universities.html [L]
RewriteRule ^universities/[^/]+/?$ university.html [L]
RewriteRule ^ranking/?$ ranking.html [L]
RewriteRule ^guide/?$ guide.html [L]
RewriteRule ^about/?$ about.html [L]

# Custom error page for unknown paths.
ErrorDocument 404 /404.html
